# Modelo de configuração — copie para `.env` e preencha.
# NUNCA comite `.env` (já está no .gitignore). Todo valor aqui é placeholder.

# Ambiente ("development" localmente; "production" no Render).
ENVIRONMENT=development

# NUNCA true em produção — o boot falha sozinho se ENVIRONMENT=production
# e DEBUG=true ao mesmo tempo (ver app/core/config.py).
DEBUG=true

# Lista JSON de origens permitidas (pydantic-settings espera JSON, não
# CSV). Em produção, a URL real do frontend no Vercel — nunca "*".
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Diretório alternativo de conteúdo (default: app/data). Usado pelos testes.
# DATA_DIR=app/data

# Paginação e teto de busca (defaults já seguros).
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100
# MAX_SEARCH_RESULTS=50

# Limite de escrita por IP (mural de velas e chat). O contador é em memória
# do PROCESSO — não vale multi-worker nem multi-instância (ver
# app/core/rate_limiting.py). Desligue só em ambiente controlado.
# RATE_LIMIT_ENABLED=true

# Opcional: string de conexão Postgres do mural de velas, do cache da
# liturgia diária e do índice do chatbot (ex.: Neon).
# Sem esta variável, a API sobe normalmente e só /api/velas,
# /api/liturgia-diaria e /api/chat respondem 503.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chatbot do acervo (/api/chat, RAG). Sem DEEPSEEK_API_KEY, VOYAGE_API_KEY e
# DATABASE_URL, o endpoint responde 503 e o resto da API segue normal.
# DEEPSEEK_API_KEY=sk-substitua-pela-chave-real
# VOYAGE_API_KEY=pa-substitua-pela-chave-real
# DEEPSEEK_MODEL=deepseek-chat        # default, não precisa declarar
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # default (API compatível com OpenAI)
# VOYAGE_EMBEDDING_MODEL=voyage-3.5-lite      # default
# VOYAGE_EMBEDDING_DIMENSIONS=512     # default — muda junto com o modelo
# CHAT_MAX_CONTEXT_CHUNKS=6           # default

# Imagens sincronizadas antes do deploy. A URL deve apontar para o domínio que
# publica o prefixo /img-acervo do bucket/CDN; sem ela, a origem é preservada.
# IMAGE_CDN_BASE_URL=https://cdn.seu-dominio.com
# IMAGE_MANIFEST_PATH=app/data/image-manifest.json  # default
